# MongoDB cluster. Can be the same cluster as the website backend.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
# This app's own database on that cluster. Never point it at another app's database ("test" is the website backend's).
MONGODB_DB=flashfire_attendance
# Optional, read-only: the CRM's database on the same cluster. Active CRM admins become admins here when they sign in.
CRM_DB_NAME=test

# Signs login cookies and hashes OTP codes. At least 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=

# Comma separated emails that are always admins. They can sign in even before any domain is allowed.
ADMIN_EMAILS=sohith@flashfirehq.com

# Company domains allowed to sign in when the settings document is first created. Admins edit the list in the app after that.
DEFAULT_ALLOWED_DOMAINS=flashfirehq.com

# The one account that can sign in with a password (from the normal login page). Always an admin.
# Use a long random password in production and keep it out of chat and git.
DEFAULT_ADMIN_EMAIL=admin@flashfirehq.com
DEFAULT_ADMIN_PASSWORD=

# SMTP for login codes, same setup as the dashboard backend (Gmail with an app password).
# Without SMTP_USER and SMTP_PASS, codes are printed to the server log in development and sending fails in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FlashFire Team

# Optional: public URL used in email links (e.g. https://attendance.flashfirejobs.com). Defaults to the host the request came in on.
APP_URL=
